@startuml
title CineSmart — Sequence Diagram: Phase 4 Booking Confirmation, Payment Processing & Refund

autonumber
skinparam monochrome false
skinparam roundcorner 8
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12

actor "Customer" as Customer
participant "React Frontend" as UI
participant "BookingController" as BookCtrl
participant "BookingService" as BookSvc
participant "PaymentController" as PayCtrl
participant "PaymentService" as PaySvc
participant "PaymentGateway (Strategy)" as Gateway
participant "TicketService" as TicketSvc
database "PostgreSQL Database" as DB

== Flow 1: Seat Selection & Pending Booking Creation ==

Customer -> UI : Select Seats [A1, A2] & Click "Proceed to Payment"
activate UI
UI -> BookCtrl : POST /api/bookings\n{showId: 1, seatIds: [10, 11]}
activate BookCtrl

BookCtrl -> BookSvc : createBooking(userId, request)
activate BookSvc

BookSvc -> DB : BEGIN TRANSACTION\nSELECT * FROM show_seats WHERE id IN (10, 11) FOR UPDATE
activate DB
DB --> BookSvc : Seats locked (Status = AVAILABLE)

BookSvc -> BookSvc : Calculate Server-Side Amount (Total = ₹300.00)
BookSvc -> DB : UPDATE show_seats SET status = 'HELD' WHERE id IN (10, 11)
BookSvc -> DB : INSERT INTO bookings (booking_ref, status = 'PENDING_PAYMENT', total_amount = 300.00)
BookSvc -> DB : COMMIT TRANSACTION
deactivate DB

BookSvc --> BookCtrl : BookingDTO (id: 12, reference: "CS-2026-000012", status: "PENDING_PAYMENT")
deactivate BookSvc
BookCtrl --> UI : 201 Created (BookingDTO)
deactivate BookCtrl

UI -> Customer : Display Payment Modal with Server-Calculated Amount (₹300.00)

== Flow 2: Payment Initiation & Gateway Processing ==

Customer -> UI : Selects Payment Method (UPI) & Clicks "Pay Now"
UI -> PayCtrl : POST /api/payments\n{bookingId: 12, paymentMethod: "UPI"}
activate PayCtrl

PayCtrl -> PaySvc : initiatePayment(userId, request)
activate PaySvc

PaySvc -> DB : SELECT * FROM bookings WHERE id = 12
activate DB
DB --> PaySvc : Booking (status: PENDING_PAYMENT, amount: 300.00)
deactivate DB

PaySvc -> DB : INSERT INTO payment_transactions\n(txn_ref, booking_id, amount, status = 'INITIATED', method = 'UPI')
activate DB
deactivate DB

PaySvc --> PayCtrl : PaymentTransactionDTO (id: 45, status: "INITIATED")
deactivate PaySvc
PayCtrl --> UI : 201 Created (PaymentTransactionDTO)
deactivate PayCtrl

UI -> PayCtrl : POST /api/payments/45/process\n{simulateSuccess: true}
activate PayCtrl
PayCtrl -> PaySvc : processPayment(userId, txnId = 45, request)
activate PaySvc

PaySvc -> DB : UPDATE payment_transactions SET status = 'PROCESSING'
activate DB
deactivate DB

PaySvc -> Gateway : processPayment(PaymentGatewayRequest)
activate Gateway

alt Gateway Processing: SUCCESS
    Gateway --> PaySvc : PaymentGatewayResponse (SUCCESS, gatewayRef: "MOCK-GW-XXXXXX")
    deactivate Gateway

    PaySvc -> DB : UPDATE payment_transactions SET status = 'SUCCESS', completed_at = NOW()
    activate DB
    deactivate DB

    PaySvc -> BookSvc : confirmBooking(bookingId = 12)
    activate BookSvc
    BookSvc -> DB : UPDATE bookings SET status = 'CONFIRMED', confirmed_at = NOW()
    activate DB
    BookSvc -> DB : UPDATE show_seats SET status = 'BOOKED' WHERE id IN (10, 11)
    deactivate DB

    BookSvc -> TicketSvc : generateTicketsForBooking(booking)
    activate TicketSvc
    TicketSvc -> DB : INSERT INTO tickets (ticket_code: "TKT-2026-XXXXXX", qr_hash, status: 'ACTIVE')
    activate DB
    deactivate DB
    TicketSvc --> BookSvc : List<TicketDTO>
    deactivate TicketSvc

    BookSvc --> PaySvc : BookingConfirmed
    deactivate BookSvc

    PaySvc --> PayCtrl : PaymentTransactionDTO (status: SUCCESS, tickets: [...])
    PayCtrl --> UI : 200 OK (Payment & Booking Confirmed, Digital Tickets with QR)
    UI -> Customer : Display Success Screen with Ticket Passes & QR Hashes

else Gateway Processing: DECLINE / FAILED
    activate Gateway
    Gateway --> PaySvc : PaymentGatewayResponse (FAILED, failureReason: "Card declined")
    deactivate Gateway

    PaySvc -> DB : UPDATE payment_transactions SET status = 'FAILED'
    activate DB
    deactivate DB

    PaySvc -> BookSvc : handlePaymentFailure(bookingId = 12)
    activate BookSvc
    BookSvc -> DB : UPDATE bookings SET status = 'PAYMENT_FAILED'
    activate DB
    BookSvc -> DB : UPDATE show_seats SET status = 'AVAILABLE' WHERE id IN (10, 11)
    deactivate DB
    BookSvc --> PaySvc : FailureHandled
    deactivate BookSvc

    PaySvc --> PayCtrl : PaymentTransactionDTO (status: FAILED)
    PayCtrl --> UI : 400 Bad Request / Failed Response
    UI -> Customer : Display "Payment Failed. Selected seats have been released."
end
deactivate PaySvc
deactivate PayCtrl

== Flow 3: Cancellation & Refund Workflow ==

Customer -> UI : Click "Cancel Booking" on Confirmed Reservation
UI -> BookCtrl : POST /api/bookings/12/cancel
activate BookCtrl

BookCtrl -> BookSvc : cancelBooking(userId, bookingId = 12)
activate BookSvc

BookSvc -> DB : SELECT * FROM bookings WHERE id = 12
activate DB
DB --> BookSvc : Booking (status: CONFIRMED)
deactivate DB

BookSvc -> DB : UPDATE bookings SET status = 'CANCELLED'
activate DB
BookSvc -> DB : UPDATE show_seats SET status = 'AVAILABLE' WHERE id IN (10, 11)
BookSvc -> DB : UPDATE tickets SET status = 'CANCELLED' WHERE booking_id = 12
deactivate DB

BookSvc -> PaySvc : refundBookingPayment(bookingId = 12)
activate PaySvc

PaySvc -> Gateway : refundPayment(RefundGatewayRequest)
activate Gateway
Gateway --> PaySvc : RefundGatewayResponse (REFUNDED, refundRef: "REFUND-MOCK-XXXX")
deactivate Gateway

PaySvc -> DB : UPDATE payment_transactions SET status = 'REFUNDED'
activate DB
deactivate DB

PaySvc --> BookSvc : RefundSuccessful
deactivate PaySvc

BookSvc --> BookCtrl : BookingDTO (status: CANCELLED)
deactivate BookSvc

BookCtrl --> UI : 200 OK (Booking Cancelled & Refunded)
deactivate BookCtrl

UI -> Customer : Notification: "Booking Cancelled & Refund Initiated"
deactivate UI

@enduml
