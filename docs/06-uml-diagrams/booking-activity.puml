@startuml
title CineSmart — Activity Diagram: Phase 4 Booking, Payment Confirmation & Cancellation

start

:Customer selects Movie, Showtime, and Seats (or Phase 3 Smart Group);

:Customer clicks "Proceed to Payment";

partition "Booking Creation & Validation" {
  :Lock requested seats (SELECT FOR UPDATE);
  if (All seats AVAILABLE?) then (yes)
    :Calculate Total Amount Server-Side;
    :Mark ShowSeats HELD;
    :Create Booking (PENDING_PAYMENT);
    :Return Booking details to UI;
  else (no - seat conflict)
    :Rollback Transaction;
    :Display "Selected seats are no longer available";
    stop
  endif
}

:Display Payment Modal;
:Customer selects Payment Method (UPI, CARD, NET_BANKING, WALLET);
:System initiates Payment Transaction (INITIATED);

partition "Payment Processing (Strategy Pattern)" {
  :Transition Transaction to PROCESSING;
  :Dispatch to PaymentGateway (MockPaymentGateway);

  if (Payment Successful?) then (yes)
    :Update Transaction to SUCCESS;
    partition "Booking Confirmation & Ticket Generation" {
      :Update Booking to CONFIRMED;
      :Update ShowSeats to BOOKED;
      :Generate Digital Tickets (TKT-2026-XXXXXX);
      :Compute SHA-256 QR Verification Token;
      :Save Tickets to Database;
    }
    :Display Payment Successful & Booking Confirmed screen;
    :Render Digital Tickets with QR code hash;
  else (no / gateway decline)
    :Update Transaction to FAILED;
    partition "Failure Rollback & Seat Release" {
      :Update Booking to PAYMENT_FAILED;
      :Release ShowSeats to AVAILABLE;
    }
    :Display "Payment Failed. Your held seats have been released";
    stop
  endif
}

if (Customer requests Cancellation later?) then (yes)
  partition "Cancellation & Refund Workflow" {
    :Verify User Authorization & Showtime;
    if (Showtime has already passed?) then (yes)
      :Reject Cancellation;
      stop
    else (no)
      :Update Booking to CANCELLED;
      :Release ShowSeats to AVAILABLE;
      :Mark Tickets CANCELLED;
      if (Booking was Paid / CONFIRMED?) then (yes)
        :Dispatch Refund to PaymentGateway;
        :Gateway returns Refund Reference;
        :Update PaymentTransaction to REFUNDED;
      endif
      :Display "Booking Cancelled & Refund Initiated";
    endif
  }
else (no)
  :Customer enjoys the movie!;
endif

stop

@enduml
